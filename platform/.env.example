# ==== platform/.env （docker compose 用）====
# 本ファイルを .env にコピーして利用する

# PostgreSQL
POSTGRES_USER=dms
POSTGRES_PASSWORD=dms_password
POSTGRES_DB=dms
POSTGRES_PORT=5432

# OpenSearch
OPENSEARCH_PORT=9200
OPENSEARCH_ADMIN_PASSWORD=Dms!Search1

# MinIO (S3互換)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend
BACKEND_PORT=8000
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OCR
OCR_LANG=jpn+jpn_vert+eng      # 縦書き(jpn_vert)対応。モデルは ocr-worker イメージに同梱

# 要約 (Dify)。DIFY_API_KEY が空ならルールベースの簡易要約にフォールバックする。
# Dify でアプリを作成し、APIキーと（自己ホストなら）エンドポイントを設定する。
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_APP_TYPE=completion          # completion | workflow
DIFY_INPUT_VAR=text               # Difyアプリの入力変数名
DIFY_OUTPUT_VAR=summary           # workflow時の出力ノード変数名

# Web
WEB_PORT=5173
