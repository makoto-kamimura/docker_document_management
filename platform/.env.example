# ==== platform/.env （docker compose 用）====
# 本ファイルを .env にコピーして利用する

# PostgreSQL
POSTGRES_USER=dms
POSTGRES_PASSWORD=dms_password
POSTGRES_DB=dms
POSTGRES_PORT=5432

# OpenSearch
OPENSEARCH_PORT=9200
OPENSEARCH_ADMIN_PASSWORD=Dms!Search1

# MinIO (S3互換)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend
BACKEND_PORT=8000
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OCR
OCR_LANG=jpn+jpn_vert+eng      # 縦書き(jpn_vert)対応。モデルは ocr-worker イメージに同梱

# 要約 (Dify)。DIFY_API_KEY が空ならルールベースの簡易要約にフォールバックする。
# Dify でアプリを作成し、APIキーと（自己ホストなら）エンドポイントを設定する。
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_APP_TYPE=completion          # completion | workflow
DIFY_INPUT_VAR=text               # Difyアプリの入力変数名
DIFY_OUTPUT_VAR=summary           # workflow時の出力ノード変数名

# 家族への通知（アプリ内通知 + Expo プッシュ）
# プッシュは端末が Expo Push Token を登録したときだけ送る（モバイルに EAS の projectId を設定した場合）。
# プッシュ本文に書類の中身は含めない。PUSH_ENABLED=false で外部送信を止められる（アプリ内通知は残る）。
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=
REMINDER_INTERVAL_HOURS=24        # 未確認の家族へのリマインド間隔
REMINDER_MAX_COUNT=3              # 1人・1書類あたりのリマインド上限
DEADLINE_NOTICE_DAYS=1            # 期限の何日前に通知するか
TZ_OFFSET_HOURS=9                 # 期限判定のタイムゾーン（日本時間）

# Web
WEB_PORT=5173

# ==== テナント（デモ / 実利用のデータ分離）====
# 起動時に実利用テナントとデモテナントを用意し、初期ユーザーを投入する。
TENANT_PRIMARY_SLUG=family        # 実利用テナントの識別子
TENANT_PRIMARY_NAME=我が家         # 実利用テナントの表示名
TENANT_DEMO_SLUG=demo             # デモテナントの識別子
TENANT_DEMO_NAME=デモ              # デモテナントの表示名
# テナント導入前からあるデータ（ユーザー/グループ/書類）の移行先。初回起動前にのみ有効
SEED_LEGACY_TENANT_SLUG=family

# 全体管理者（テナントに属さず全テナントを管理する**非公開**アカウント）。
# パスワード未設定なら自動生成してログに1度だけ出力する。メールを空にすると作成しない
SEED_SUPER_ADMIN_EMAIL=super@example.com
SEED_SUPER_ADMIN_PASSWORD=
# 実利用テナントの管理者。既定値はデモ用として公開してきた認証情報なので、
# DBが空のうちに自分のアカウント＋強いパスワードへ必ず変更すること
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
# デモテナントの公開アカウント。ロールごとの見え方を試せるよう3つ用意し、同じグループに入れる
# （パスワードは3つ共通。空にしたアカウントは作成しない）
SEED_DEMO_PASSWORD=demo123
SEED_DEMO_ADMIN_EMAIL=demo@example.com
SEED_DEMO_REGISTRAR_EMAIL=demo-registrar@example.com
SEED_DEMO_VIEWER_EMAIL=demo-viewer@example.com
SEED_DEMO_GROUP_NAME=デモ家族
