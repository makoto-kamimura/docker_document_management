{
  "expo": {
    "name": "紙ログ",
    "slug": "dms-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4f46e5"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "紙資料の撮影のためにカメラを使用します。"
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "expo-font",
      "expo-web-browser"
    ],
    "icon": "./assets/icon.png",
    "scheme": "dms"
  }
}
